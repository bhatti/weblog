stateDiagram-v2
    [*] --> allow: default
    allow --> review: policy = review
    review --> approved: human or automated check passes
    review --> denied: check fails
    approved --> allow: reset
    denied --> allow: policy cleared
    allow --> denied: policy = deny (direct block)
