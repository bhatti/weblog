graph LR
    subgraph HARD["🔧 Hard Skills"]
        H1["Coding & Implementation"]
        H2["Specification Writing"]
        H3["System Design & Architecture"]
        H4["Non-Functional Requirements\n(perf, scale, security, reliability)"]
        H5["Code Review & Smell Detection"]
        H6["Debugging & Incident Response"]
        H7["Testing Strategy"]
        H8["Conceptual Integrity"]
    end

    subgraph SOFT["🤝 Soft Skills"]
        S1["Written Communication\n(design docs, RFCs, post-mortems)"]
        S2["Building Consensus & Alignment"]
        S3["Estimation & Decomposition"]
        S4["Mentorship & Knowledge Sharing"]
        S5["Stakeholder Communication\n(translate tech → business impact)"]
        S6["Project Ownership &\nDelivery"]
        S7["Ambiguity Reduction\n(clarify problem + solution)"]
        S8["Psychological Safety &\nTeam Health"]
    end

    subgraph LEVELS["📈 Career Levels"]
        L1["Junior\nComponent ownership\nWell-defined tasks"]
        L2["Mid-Level \nFeature ownership\nAutonomous delivery"]
        L3["Senior\nTeam architecture\nMulti-engineer projects"]
        L4["Staff / Principal\nOrg-wide strategy\nForce multiplier"]
    end

    H1 & H2 --> L1
    H3 & H4 & H5 --> L2
    H6 & H7 & H8 --> L3

    S1 & S3 --> L1
    S2 & S4 & S6 --> L2
    S5 & S7 & S8 --> L3
    S2 & S5 & S7 --> L4

    style HARD fill:#1a3a5c,color:#fff,stroke:#3498db,stroke-width:2px
    style SOFT fill:#2c1a5c,color:#fff,stroke:#9b59b6,stroke-width:2px
    style LEVELS fill:#1a4a2a,color:#fff,stroke:#27ae60,stroke-width:2px
    style H1 fill:#2471a3,color:#fff,stroke:none
    style H2 fill:#1a6fa0,color:#fff,stroke:none
    style H3 fill:#1a6090,color:#fff,stroke:none
    style H4 fill:#155070,color:#fff,stroke:none
    style H5 fill:#0e3f5c,color:#fff,stroke:none
    style H6 fill:#0a3050,color:#fff,stroke:none
    style H7 fill:#072040,color:#fff,stroke:none
    style H8 fill:#051530,color:#fff,stroke:none
    style S1 fill:#7d3c98,color:#fff,stroke:none
    style S2 fill:#6c3483,color:#fff,stroke:none
    style S3 fill:#5b2c6f,color:#fff,stroke:none
    style S4 fill:#4a235a,color:#fff,stroke:none
    style S5 fill:#3a1a48,color:#fff,stroke:none
    style S6 fill:#2e1540,color:#fff,stroke:none
    style S7 fill:#231038,color:#fff,stroke:none
    style S8 fill:#180b2e,color:#fff,stroke:none
    style L1 fill:#1e8449,color:#fff,stroke:none
    style L2 fill:#196f3d,color:#fff,stroke:none
    style L3 fill:#145a32,color:#fff,stroke:none
    style L4 fill:#0e4525,color:#fff,stroke:none

