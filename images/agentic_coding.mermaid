flowchart TD
    subgraph OLD["Traditional Learning Loop 🔄"]
        direction TB
        A1["Write Spec"] --> B1["Implement Code"]
        B1 --> C1["Hit Design Consequences\n(painful abstractions, missing locks,\nbad coupling)"]
        C1 --> D1["Senior Code Review\n+ Feedback"]
        D1 --> E1["Internalize Lessons\n→ Build Mental Model"]
        E1 --> A1
    end

    subgraph NEW["Agentic Coding Loop ⚡"]
        direction TB
        A2["Write Spec\n(often vague)"] --> B2["Agent Generates Code\n(fast, clean-looking)"]
        B2 --> C2["Engineer Reviews\n(no build pain felt)"]
        C2 --> D2["Approve / Merge"]
        D2 --> E2["Skills Gap Accumulates\n→ Mental model never built"]
    end

    OLD -- "Agentic era\nshort-circuits" --> NEW

    style OLD fill:#1a472a,color:#fff,stroke:#2ecc71,stroke-width:2px
    style NEW fill:#4a1010,color:#fff,stroke:#e74c3c,stroke-width:2px
    style A1 fill:#2ecc71,color:#000,stroke:none
    style B1 fill:#27ae60,color:#fff,stroke:none
    style C1 fill:#f39c12,color:#000,stroke:none
    style D1 fill:#2980b9,color:#fff,stroke:none
    style E1 fill:#1abc9c,color:#000,stroke:none
    style A2 fill:#e74c3c,color:#fff,stroke:none
    style B2 fill:#c0392b,color:#fff,stroke:none
    style C2 fill:#e67e22,color:#000,stroke:none
    style D2 fill:#7f8c8d,color:#fff,stroke:none
    style E2 fill:#922b21,color:#fff,stroke:none
