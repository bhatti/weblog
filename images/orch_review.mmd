flowchart TD
    PR["📋 Pull request<br/>diff + description"]

    subgraph diverge [" DIVERGE — four passes, each blind to the other three "]
        direction LR
        C1["🔍 Correctness<br/>logic · null handling<br/>races · swallowed errors"]
        C2["🔒 Security<br/>injection · authZ<br/>data exposure · crypto"]
        C3["🔗 API surface<br/>breaking changes<br/>versioning · compat"]
        C4["📡 SRE<br/>failure modes<br/>observability · rollback"]
    end

    CONVERGE["⚖️ CONVERGE — merge, dedupe, rank<br/>CRITICAL → HIGH → MEDIUM → LOW"]

    subgraph verdict [" VERDICT → HUMAN GATE "]
        direction LR
        V1["✅ APPROVE<br/>no HIGH/CRITICAL"]
        V2["🔄 REQUEST CHANGES<br/>HIGH or CRITICAL"]
        V3["💬 COMMENT<br/>MEDIUM/LOW only"]
    end

    SLACK["📱 Block Kit message in Slack<br/>Approve · Request Changes · Verify<br/>→ job pauses, waits for a click"]

    PR --> C1 & C2 & C3 & C4
    C1 & C2 & C3 & C4 --> CONVERGE
    CONVERGE --> V1 & V2 & V3
    V1 & V2 & V3 --> SLACK

    style PR fill:#1a6bc4,color:#ffffff,stroke:#0d4a8a,stroke-width:2px
    style C1 fill:#0e7c4a,color:#ffffff,stroke:#084d2e,stroke-width:2px
    style C2 fill:#be123c,color:#ffffff,stroke:#881337,stroke-width:2px
    style C3 fill:#b45309,color:#ffffff,stroke:#7c3a04,stroke-width:2px
    style C4 fill:#6d28d9,color:#ffffff,stroke:#4c1d95,stroke-width:2px
    style CONVERGE fill:#0f766e,color:#ffffff,stroke:#0a4f4a,stroke-width:2px
    style V1 fill:#0e7c4a,color:#ffffff,stroke:#084d2e,stroke-width:2px
    style V2 fill:#be123c,color:#ffffff,stroke:#881337,stroke-width:2px
    style V3 fill:#b45309,color:#ffffff,stroke:#7c3a04,stroke-width:2px
    style SLACK fill:#1a6bc4,color:#ffffff,stroke:#0d4a8a,stroke-width:2px
